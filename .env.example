# ===== Trend Vision One (poller de Workbench alerts) =====
# Base URL regional de la API (ver tu consola): api.xdr.trendmicro.com (US),
# api.eu.xdr.trendmicro.com (EU), api.xdr.trendmicro.co.jp (JP), etc.
TV1_BASE_URL=
# API key generado en Administration -> API Keys con rol Workbench "View".
TV1_API_TOKEN=
# Cada cuánto consulta TV1 (segundos).
TV1_POLL_INTERVAL_SECONDS=60
# Solape hacia atrás para no perder alertas en el borde de la ventana (segundos).
TV1_POLL_OVERLAP_SECONDS=120
# Ventana del primer ciclo tras un arranque limpio (minutos). Corto a propósito:
# evita reprocesar el backlog histórico (y la facturación de OpenAI) al iniciar.
TV1_INITIAL_LOOKBACK_MINUTES=5
# Severidad mínima a procesar (vacío = todas). Ej: medium -> medium/high/critical.
TV1_MIN_SEVERITY=
# Master switch del poller.
ENABLE_TV1_POLLER=false